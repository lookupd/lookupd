{
  "name": "lookupd",
  "version": "0.3.0",
  "mcpName": "com.lookupd/lookupd",
  "description": "Find the right MCP server, skill or agent for a task. CLI + stdio MCP bridge for the lookupd registry.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lookupd": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lookupd/lookupd.git"
  },
  "homepage": "https://lookupd.com",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "registry",
    "agents",
    "skills",
    "claude-code"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
